{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClassifAI Studio",
  "version": "0.1.0",
  "identifier": "dev.classifai.app",
  "build": {
    "beforeDevCommand": "sh scripts/build-cli.sh debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && sh scripts/build-cli.sh release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClassifAI Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 27.5
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "externalBin": [
      "binaries/classifai"
    ],
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Classify data with local decision models",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
